# --- Appearance & Theme ---
# Tokyo Night (Night バリアント, 背景 #1a1b26)
theme = TokyoNight
# 文字は白寄りに上書き (デフォルト #c0caf5 は少し暗いため)
foreground = #ffffff

background-opacity = 1.0
background-blur-radius = 0

# --- Working Directory ---
# 継承しない場合の基準パス（初回起動・新規タブ/ウィンドウ）
working-directory = ~/dev
# split (cmd+d) は現在の cwd を引き継ぐ
split-inherit-working-directory = true
# 新規タブ (cmd+T)・新規ウィンドウ (cmd+N) は working-directory(~/dev) で開く
tab-inherit-working-directory = false
window-inherit-working-directory = false

# --- Keybind ---
keybind = super+s=text:\x1bw\x0dd
# 既定の super+enter=toggle_fullscreen を解放し、cmd+Enter を中のアプリへ通す
# （Claude Code の送信キーに割り当てるため。フルスクリーンは super+ctrl+f に退避）
keybind = super+enter=unbind
keybind = super+ctrl+f=toggle_fullscreen

# --- Font ---
font-family = "UDEV Gothic 35NF"
font-size = 14
font-feature = -dlig
font-thicken = true
font-thicken-strength = 128

# フォントスタイルをシンプルに固定
font-style-bold = false
font-style-italic = false
font-style-bold-italic = false

# 文字の間隔・描画調整
adjust-cell-width = 0%
adjust-cell-height = 10%
alpha-blending = linear

# --- Window & macOS UI ---
# 装飾の排除
# hidden: タイトルバーを非表示にする（ネイティブのウィンドウボーダー・丸角は保持）
macos-titlebar-style = hidden
macos-window-shadow = false

# 余白設定
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# --- Cursor ---
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = true
cursor-opacity = 0.8

# --- TUI 互換（文字幅）---
# Ghostty 既定の unicode 幅計算は herdr など wcwidth 系の TUI と食い違い、
# Nerd Font アイコンや CJK・絵文字でカーソル位置がズレて「残像/行重複」が出る。
# legacy(wcwidth) に合わせて幅を一致させる。
grapheme-width-method = legacy

# --- Input & Mouse ---
# ターミナル側で Option を Alt として渡す（TUI のキーバインド用）
macos-option-as-alt = true
mouse-scroll-multiplier = 2
mouse-hide-while-typing = true

# --- Interaction ---
shell-integration-features = no-cursor
resize-overlay = never
