# --- Appearance & Theme ---
# Tokyo Night (Night バリアント, 背景 #1a1b26)
theme = TokyoNight
# 文字は白寄りに上書き (デフォルト #c0caf5 は少し暗いため)
foreground = #ffffff

background-opacity = 1.0
background-blur-radius = 0

# --- Working Directory ---
# 継承しない場合の基準パス（初回起動・新規タブ/ウィンドウ）
working-directory = ~/dev
# split (cmd+d) は現在の cwd を引き継ぐ
split-inherit-working-directory = true
# 新規タブ (cmd+T) は working-directory(~/dev) で開く
# cmd+N は herdr の新規スペース作成へ中継する
tab-inherit-working-directory = false
window-inherit-working-directory = false

# --- Keybind ---
# 既定の super+enter=toggle_fullscreen を解放し、cmd+Enter を中のアプリへ通す
# （Claude Code の送信キーに割り当てるため。フルスクリーンは super+ctrl+f に退避）
keybind = super+enter=unbind
keybind = super+ctrl+f=toggle_fullscreen

# --- herdr へのキー中継 ---
# 多重化は herdr に一本化し、Ghostty の split/tab は使わない。
# cmd+X を ESC+文字 (= alt+文字) に変換して herdr の direct binding へ渡す。
# 中継に alt+[ / alt+] は使えない。ESC[ は CSI、ESC] は OSC の開始と解釈されるため、
# agent 移動だけ中継を n/p にしている。
keybind = super+n=text:\x1bN
keybind = super+]=text:\x1bn
keybind = super+[=text:\x1bp
keybind = super+d=text:\x1bd
keybind = super+shift+d=text:\x1bD
keybind = super+w=text:\x1bw
keybind = super+t=text:\x1bt
keybind = super+g=text:\x1bg
keybind = super+alt+arrow_left=text:\x1bh
keybind = super+alt+arrow_down=text:\x1bj
keybind = super+alt+arrow_up=text:\x1bk
keybind = super+alt+arrow_right=text:\x1bl
keybind = super+digit_1=text:\x1b1
keybind = super+digit_2=text:\x1b2
keybind = super+digit_3=text:\x1b3
keybind = super+digit_4=text:\x1b4
keybind = super+digit_5=text:\x1b5
keybind = super+digit_6=text:\x1b6
keybind = super+digit_7=text:\x1b7
keybind = super+digit_8=text:\x1b8
keybind = super+1=text:\x1b1
keybind = super+2=text:\x1b2
keybind = super+3=text:\x1b3
keybind = super+4=text:\x1b4
keybind = super+5=text:\x1b5
keybind = super+6=text:\x1b6
keybind = super+7=text:\x1b7
keybind = super+8=text:\x1b8
keybind = super+9=text:\x1b9

# --- Font ---
font-family = "UDEV Gothic 35NF"
font-size = 14
font-feature = -dlig
font-thicken = true
font-thicken-strength = 128

# フォントスタイルをシンプルに固定
font-style-bold = false
font-style-italic = false
font-style-bold-italic = false

# 文字の間隔・描画調整
adjust-cell-width = 0%
adjust-cell-height = 10%
alpha-blending = linear

# --- Window & macOS UI ---
# 装飾の排除
# hidden: タイトルバーを非表示にする（ネイティブのウィンドウボーダー・丸角は保持）
macos-titlebar-style = hidden
macos-window-shadow = false

# 余白設定
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# --- Cursor ---
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = true
cursor-opacity = 0.8

# --- TUI 互換（文字幅）---
# Ghostty 既定の unicode 幅計算は herdr など wcwidth 系の TUI と食い違い、
# Nerd Font アイコンや CJK・絵文字でカーソル位置がズレて「残像/行重複」が出る。
# legacy(wcwidth) に合わせて幅を一致させる。
grapheme-width-method = legacy

# --- Input & Mouse ---
# ターミナル側で Option を Alt として渡す（TUI のキーバインド用）
macos-option-as-alt = true
mouse-scroll-multiplier = 2
mouse-hide-while-typing = true

# --- Interaction ---
shell-integration-features = no-cursor
resize-overlay = never
