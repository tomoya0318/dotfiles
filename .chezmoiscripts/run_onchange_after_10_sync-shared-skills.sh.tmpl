#!/bin/bash
# skills/ の構成か、配布先の symlink の状態が変わったら再実行:
# state: {{ output "sh" "-c" (printf `for s in %s/skills/*/; do n=${s%%/}; n=${n##*/}; printf "%%s|%%s|%%s\n" "$n" "$(readlink "$HOME/.claude/skills/$n" 2>/dev/null)" "$(readlink "$HOME/.agents/skills/$n" 2>/dev/null)"; done; for t in "$HOME/.claude/skills" "$HOME/.agents/skills"; do for l in "$t"/*; do [ -L "$l" ] && printf "link|%%s|%%s\n" "${l##*/}" "$(readlink "$l")"; done; done` .chezmoi.sourceDir) | sha256sum }}
#
# 無条件の run スクリプトにすると chezmoi verify が常に保留を報告する。
# 配布先の状態もトリガに含めているので、symlink を手で消しても次の apply で戻る。
# chezmoiリポジトリ直下の skills/<skill-name>/ を、Claude/Codex双方の
# ユーザーグローバルスキルとして直接参照させる。
set -euo pipefail

source_root="{{ .chezmoi.sourceDir }}/skills"

link_skill() {
  local target="$1"
  local link_target="$2"
  mkdir -p "$(dirname "$target")"

  if [ -L "$target" ]; then
    if [ "$(readlink "$target")" != "$link_target" ]; then
      rm "$target"
      ln -s "$link_target" "$target"
    fi
  elif [ -e "$target" ]; then
    echo "shared skill target already exists and is not a symlink: $target" >&2
    return 1
  else
    ln -s "$link_target" "$target"
  fi
}

# 正本から消えた skill の symlink を刈る。刈らないと、skill を削除するたびに
# 参照先の無いリンクが両エージェントのディレクトリに残り続ける。
prune_stale_links() {
  local dir="$1"
  [ -d "$dir" ] || return 0

  local link
  for link in "$dir"/*; do
    [ -L "$link" ] || continue
    case "$(readlink "$link")" in
      "$source_root"/*) [ -e "$link" ] || rm "$link" ;;
    esac
  done
}

for skill_source in "$source_root"/*; do
  [ -d "$skill_source" ] || continue
  [ -f "$skill_source/SKILL.md" ] || continue

  skill_name="${skill_source##*/}"

  link_skill "$HOME/.agents/skills/$skill_name" "$skill_source"
  link_skill "$HOME/.claude/skills/$skill_name" "$skill_source"
done

prune_stale_links "$HOME/.agents/skills"
prune_stale_links "$HOME/.claude/skills"
