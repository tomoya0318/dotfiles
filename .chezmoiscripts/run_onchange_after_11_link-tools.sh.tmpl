#!/bin/bash
# tools/ の構成か、~/dev の symlink の状態が変わったら再実行:
# state: {{ output "sh" "-c" (printf `for t in %s/tools/*/; do n=${t%%/}; n=${n##*/}; printf "%%s|%%s\n" "$n" "$(readlink "$HOME/dev/$n" 2>/dev/null)"; done` .chezmoi.sourceDir) | sha256sum }}
#
# 無条件の run スクリプトにすると chezmoi verify が常に保留を報告する。
# ~/dev 側の状態もトリガに含めているので、symlink を手で消しても次の apply で戻る。
# chezmoiリポジトリ直下の tools/<name>/ を ~/dev/<name> から参照させる。
# コピーではなく symlink にするのは、~/dev 側を編集しても apply で
# 巻き戻らないようにするため。実体は常にひとつ。
set -euo pipefail

source_root="{{ .chezmoi.sourceDir }}/tools"
dev_root="$HOME/dev"

[ -d "$source_root" ] || exit 0
mkdir -p "$dev_root"

# 正本から消えた tool の symlink を刈る。
for link in "$dev_root"/*; do
  [ -L "$link" ] || continue
  case "$(readlink "$link")" in
    "$source_root"/*) [ -e "$link" ] || rm "$link" ;;
  esac
done

for tool_source in "$source_root"/*; do
  [ -d "$tool_source" ] || continue

  name="${tool_source##*/}"
  target="$dev_root/$name"

  if [ -L "$target" ]; then
    if [ "$(readlink "$target")" != "$tool_source" ]; then
      rm "$target"
      ln -s "$tool_source" "$target"
    fi
  elif [ -e "$target" ]; then
    echo "tool target already exists and is not a symlink: $target" >&2
    exit 1
  else
    ln -s "$tool_source" "$target"
  fi
done
