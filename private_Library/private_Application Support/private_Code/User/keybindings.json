// 既定値を上書きするには、このファイル内にキー バインドを挿入します
[
    {
        "key": "ctrl+cmd+e",
        "command": "workbench.action.chat.openInEditor"
    },
    {
        "key": "ctrl+cmd+i",
        "command": "-workbench.action.chat.open"
    },
    {
        "key": "ctrl+cmd+i",
        "command": "-workbench.panel.chat"
    },
    // パスコピー: 既定は編集中(editorFocus)だと効かないため、when 句なしで再定義する。
    // AI への指示にパスを貼る用途なので、編集中でも押せることを優先。
    {
        "key": "shift+cmd+c",
        "command": "copyFilePath"
    },
    {
        "key": "shift+alt+cmd+c",
        "command": "copyRelativeFilePath"
    },
    {
        "key": "shift+cmd+c",
        "command": "-workbench.action.terminal.openNativeConsole"
    },
    // Markdown プレビュー: 既定は editorLangId == markdown（=エディタにフォーカスが要る）
    // のため、エクスプローラ側にフォーカスがあると無反応になる。when 句を外して常時有効化。
    {
        "key": "shift+cmd+v",
        "command": "markdown.showPreview"
    },
    {
        "key": "cmd+k v",
        "command": "markdown.showPreviewToSide"
    }
]
