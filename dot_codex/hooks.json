{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/hooks/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "sh ~/.codex/hooks/runcat-usage.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
